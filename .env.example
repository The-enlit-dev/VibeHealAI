# BrixoAI backend configuration (example). Placeholders only: never put real secrets here.
# Create your own git-ignored .env with generated secrets:  npm run setup:env

# --- Required -----------------------------------------------------------------
# Access token the desktop app uses to call this backend (32 random bytes, base64url).
BRIXO_CLIENT_TOKEN=replace-me
# Key that encrypts stored provider credentials (32 random bytes, standard base64).
# Losing it makes stored credentials unreadable; reconnect providers if you change it.
BRIXO_ENCRYPTION_KEY=replace-me

# --- Optional (defaults shown) -------------------------------------------------
# Loopback only. Non-loopback needs BRIXO_ALLOW_NON_LOOPBACK=true and is not supported yet.
BRIXO_HOST=127.0.0.1
BRIXO_PORT=8787
# Base URL providers redirect back to after authorization.
BRIXO_PUBLIC_URL=http://127.0.0.1:8787
# Where connections, encrypted credentials and the audit log are stored (git-ignored).
BRIXO_DATA_DIR=.brixo-data
BRIXO_ENCRYPTION_KEY_ID=local-1
BRIXO_LOG_LEVEL=info

# --- GitHub App (optional; GitHub shows "Not configured" until all five are set) --
# See docs/integrations/GITHUB_APP_SETUP.md. Keep the private key file outside the repository.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY_PATH=
