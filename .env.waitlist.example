# Waitlist service and private admin dashboard. Copy to .env.waitlist (git-ignored) and fill in.
# `npm run site:dev` reads .env.waitlist if it exists. Placeholders only: never commit real values.

# Admin is DISABLED unless both of these are set. There is no default password.
# Create the hash with: npm run waitlist:hash-password
WAITLIST_ADMIN_USERNAME=
WAITLIST_ADMIN_PASSWORD_HASH=

# auto (default) = Secure cookies unless the host is loopback. Non-loopback hosts require HTTPS.
WAITLIST_COOKIE_SECURE=auto

# Network settings. Keep the host on loopback unless the owner has approved hosting.
WAITLIST_HOST=127.0.0.1
WAITLIST_PORT=8790
# WAITLIST_DATA_DIR=./waitlist-data
# WAITLIST_ALLOWED_ORIGINS=
